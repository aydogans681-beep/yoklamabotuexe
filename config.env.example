USER_TOKEN=""
# AC Ticket Mesaji ozelligi icin - AC token'lari bununla sifrelenir.
# Bos birakirsan ilk acilista OTOMATIK uretilir (ac-anahtar.key). Elle
# yonetmek istersen buraya en az 16 karakterlik rastgele bir dize yaz.
AC_ANAHTAR=""

# Nexora API (Nexora Panel > "Sonucu Getir"). Bir Discord ID icin sonucu
# dondururen API. NORMALDE HER AC KENDI API'sini panelden girer (herkes ayni
# API'yi kullanmaz) - bu global degerler yalnizca ISTEGE BAGLI ORTAK VARSAYILAN.
# Kendi API'sini girmemis AC'ler icin fallback olur. Genelde bos birak.
#   NEXORA_API_URL : sorgu adresi. {id} yer tutucusu Discord ID ile degisir;
#                    {id} yoksa otomatik ?discordId=... eklenir. Istege bagli
#                    {key} yer tutucusu da API key ile degisir.
#     ornek: https://nexora.ornek/api/check?discord={id}
#   NEXORA_API_KEY : API anahtari. Authorization: Bearer <key> VE x-api-key
#                    basliklarinda gonderilir (ayrica URL'de {key} olarak).
NEXORA_API_URL=""
NEXORA_API_KEY=""
