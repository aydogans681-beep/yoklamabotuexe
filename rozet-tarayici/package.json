{
  "name": "rozet-tarayici",
  "version": "0.1.0",
  "description": "/goster <davet linki> ile bir sunucuya kullanıcı hesabıyla girip üyelerin nadir Discord rozetlerini listeler. Electron masaüstü uygulaması + .exe.",
  "main": "main.js",
  "author": "Rozet Tarayıcı",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "build": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.rozet.tarayici",
    "productName": "Rozet Tarayıcı",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "tarayici.js",
      "rozetler.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "portable": {
      "artifactName": "RozetTarayici.exe"
    }
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "discord.js-selfbot-v13": "^2.15.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
