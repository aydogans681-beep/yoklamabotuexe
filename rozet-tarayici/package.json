{
  "name": "rozet-tarayici",
  "version": "0.1.0",
  "description": "/goster <davet linki> ile bir sunucuya kullanıcı hesabıyla girip üyelerin nadir Discord rozetlerini listeler. Masaüstü panel + .exe.",
  "main": "panel.js",
  "bin": "panel.js",
  "scripts": {
    "start": "node panel.js",
    "test": "node test.js",
    "build": "pkg . --targets node18-win-x64 --output dist/RozetTarayici.exe"
  },
  "pkg": {
    "scripts": ["tarayici.js", "rozetler.js", "panel-html.js"],
    "assets": ["node_modules/discord.js-selfbot-v13/**/*", "node_modules/discord.js/**/*"],
    "targets": ["node18-win-x64"],
    "outputPath": "dist"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "discord.js-selfbot-v13": "^2.15.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.3.0"
  }
}
