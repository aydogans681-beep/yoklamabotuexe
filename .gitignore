# Bağımlılıklar
node_modules/

# GİZLİ: Discord kullanıcı token'ı burada - asla commit edilmez
config.env
# token.ps1'in aldığı yedek - ESKİ token'ı içerir. "config.env" kalıbı bu adı
# kapsamıyor, ayrıca yazılmazsa bir "git add -A" token'ı depoya sokardı.
config.env.yedek

# Panel hesapları (scrypt hash içerir) ve uyarı geçmişi - sunucuda oluşur
panel-auth.json
warning-history.json
panel-audit.json
panel-settings.json
voice-activity.json
yoklama-katilim.json
canli-sahiplenme.json
# Şüpheli Log'daki Ban/Şüpheli/Temiz işaretleri - sunucuda oluşur
log-isaretleri.json

# Log gecmisi onbellegi - her acilista bastan cekmemek icin diskte tutulur.
# Buyuk olabilir ve tamamen yeniden uretilebilir, depoda yeri yok.
log-cache/

# Loglar
*.log
server/debug-web.log

# İşletim sistemi
.DS_Store
Thumbs.db

# Sunucu logosu - kullanicinin kendi dosyasi. Depoda tutulmuyor ki guncelleme
# sirasinda uzerine yazilmasin; ayrica takip edilmeyen dosya olarak kalsaydi
# guncelle.ps1'in "yerel degisiklik var" kontrolu her seferinde takilirdi.
server/public/logo.*
